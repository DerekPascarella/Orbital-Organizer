<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrbitalOrganizer"
        x:Class="OrbitalOrganizer.BatchFolderRenameWindow"
        Title="Batch Folder Move and Rename" Height="600" Width="500"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
    </Window.Styles>
    <Grid Margin="10" RowDefinitions="Auto,*,Auto">

        <TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap">
            <Run FontWeight="Bold">Folder Hierarchy</Run>
            <LineBreak/>
            <LineBreak/>
            <Run>Double-click to rename folders. Drag folders to reparent them. Changes apply when you click Save.</Run>
        </TextBlock>

        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1">
            <TreeView x:Name="FolderTreeView"
                      ItemsSource="{Binding RootNodes}"
                      DragDrop.AllowDrop="True">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                        <Border Background="{Binding IsDropTarget, Converter={x:Static local:Converters.DropTargetBackground}}"
                                BorderBrush="{Binding IsDropTarget, Converter={x:Static local:Converters.DropTargetBorderBrush}}"
                                BorderThickness="1"
                                Padding="2"
                                CornerRadius="2">
                            <Grid>
                                <TextBlock Text="{Binding DisplayName}"
                                           IsVisible="{Binding !IsEditing}"
                                           VerticalAlignment="Center"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}"
                                         IsVisible="{Binding IsEditing}"
                                         MinWidth="120"
                                         LostFocus="EditTextBox_LostFocus"
                                         KeyDown="EditTextBox_KeyDown"
                                         AttachedToVisualTree="EditTextBox_AttachedToVisualTree"/>
                            </Grid>
                        </Border>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Button HorizontalAlignment="Left" Content="Undo Last Change" Padding="15,8"
                    Click="UndoButton_Click" IsEnabled="{Binding CanUndo}"
                    ToolTip.Tip="Undo the last rename or move"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Width="80" Padding="15,8" Margin="0,0,10,0" Click="SaveButton_Click" IsDefault="True"
                        ToolTip.Tip="Apply folder changes"/>
                <Button Content="Cancel" Width="80" Padding="15,8" Click="CancelButton_Click"
                        ToolTip.Tip="Discard folder changes"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
